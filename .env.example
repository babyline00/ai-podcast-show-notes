# Absolute path to the SQLite database file. The package.json db:* scripts inline
# this via $(pwd), so you usually don't need to set it manually — but if you
# invoke prisma directly, export this first.
DATABASE_URL="file:/home/z/my-project/apps/50-ai-podcast-show-notes/db/custom.db"

# Optional: disable LLM calls and use the deterministic MockProvider (quotes,
# bios, tweets fall back to canned demo content). Useful for offline dev / CI.
# PODCAST_DISABLE_LLM=1

# The z-ai-web-dev-sdk reads its own credentials from the environment when
# ZAI.create() is called. No additional env vars are required for the MVP;
# see the README for the stretch goals (real Whisper ASR, web search for
# guest bios) which would require additional keys.
